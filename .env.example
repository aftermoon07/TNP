# ============================================================
# TNP Placement Portal — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase Configuration (required)
# Get these from: https://app.supabase.com → Project Settings → API
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------
# Google Gemini AI (required for AI features)
# Get from: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_AI_API_KEY=AIza...

# ----------------------------------------------------------
# OpenAI (optional — system falls back to Gemini if not set)
# Get from: https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_OPENAI_API_KEY=sk-...

# ----------------------------------------------------------
# VAPI AI (optional — used for voice mock-interview feature)
# Get from: https://dashboard.vapi.ai/api-keys
# ----------------------------------------------------------
NEXT_PUBLIC_VAPI_WEB_TOKEN=your-vapi-public-key
VAPI_API_KEY=your-vapi-private-key
NEXT_PUBLIC_VAPI_WORKFLOW_ID=your-vapi-workflow-id
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# ----------------------------------------------------------
# App Settings
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
